# Server Configuration
PORT=5000
NODE_ENV=development

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OCR (Scanned PDF fallback - free, local Tesseract)
# Optional absolute path to the tesseract executable, e.g. on Windows:
#   TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave empty to let the server find "tesseract" through PATH.
TESSERACT_PATH=
# Tesseract language data to use (defaults to eng).
TESSERACT_LANG=eng
# PDF page render resolution for OCR in DPI (clamped 120-400, default 200).
PDF_OCR_DPI=200

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=exam_papers

# ── Multi-provider AI layer (services/ai/) ───────────────────────────────────
# One generate() interface over an ordered provider chain. Keys are server-side
# only — never expose them to the frontend. AI_FREE_ONLY=true forbids any paid
# model: a provider whose model is not a verified FREE model is skipped, never
# called. If every free provider is down the request returns a clear error
# instead of falling back to a paid model.
#
# Default order: Token Harbor (PRIMARY) → xKiro → Groq → OpenRouter.
# Gemini is NOT in the chain anymore (legacy leg kept for back-compat only).
AI_PRIMARY_PROVIDER=tokenharbor
AI_FALLBACK_PROVIDERS=xkiro,groq,openrouter
AI_FREE_ONLY=true

# Vision route: the ONLY provider used for image understanding. Vision has NO
# cross-provider fallback — if it is down the request fails fast (never Gemini).
AI_VISION_PROVIDER=tokenharbor

# Token Harbor (PRIMARY text LLM + the ONLY vision provider) — OpenAI-compatible
# endpoint at https://tokenharbor.ai/v1. Text model and vision model are
# separate ids: use the FREE variants; keep the :free suffix.
TOKENHARBOR_API_KEY=
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free
TOKENHARBOR_VISION_MODEL=mimo-v2.5:free
# TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1

# Apinex (FALLBACK, text + vision) — OpenAI-compatible endpoint at
# https://api.apinex.bond/v1. Free tier is marked by a `free/` model-slug prefix.
APINEX_API_KEY=
APINEX_MODEL=free/deepseek-v4.1-flash
APINEX_VISION_MODEL=free/deepseek-v4.1-flash
# APINEX_BASE_URL=https://api.apinex.bond/v1

# xKiro (FALLBACK) — OpenAI-compatible. Use the FREE model; keep the :free suffix.
XKIRO_API_KEY=
# NOTE: qwen/*:free on xKiro currently HTTP-500s; minimax-m3:free is verified FREE + working (1M ctx).
XKIRO_MODEL=minimax/minimax-m3:free
# XKIRO_BASE_URL=https://api.xkiro.com/v1

# Groq (FALLBACK). Approved FREE model: openai/gpt-oss-120b. Accepts a single
# GROQ_API_KEY or a comma-separated GROQ_API_KEYS list.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (FALLBACK) — OpenAI-compatible. Use the FREE model; keep the :free
# suffix. NEVER change this to the paid 'nvidia/nemotron-3-ultra' or to
# 'openrouter/free'.
OPENROUTER_API_KEY=
# NOTE: nvidia/nemotron-3-ultra:free is not a valid OpenRouter id; -super-120b-a12b:free is verified FREE + working.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini (LAST FALLBACK). Only a verified FREE Gemini model is used; if the
# configured model is not on the free allowlist the router SKIPS Gemini rather
# than issuing a paid request. Legacy LLM_API_KEY / LLM_MODEL still work as the
# raw Gemini leg.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Comma-separated Gemini fallback models tried (in order) ONLY when every Gemini
# API key fails on the primary model with a temporary error.
LLM_FALLBACK_MODELS=

# ── Embedding Configuration ──────────────────────────────────────────────────
# 'openrouter' (default) routes ALL embeddings through OpenRouter's
# OpenAI-compatible POST /embeddings using the SAME OPENROUTER_API_KEY as the
# LLM leg — no Gemini calls for vectors. Default model:
#   nvidia/llama-nemotron-embed-vl-1b-v2:free  (2048-dim, FREE)
# 'gemini' switches back to the legacy Gemini embedding API (gemini-embedding-001,
# 3072-dim). IMPORTANT: the two dimensions differ — switching providers requires
# re-indexing (fresh Qdrant collection / new QDRANT_COLLECTION name).
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Only read when EMBEDDING_PROVIDER=gemini (legacy Gemini model id).
EMBEDDING_MODEL=gemini-embedding-001

# Agent Control Parameters
SIMILARITY_THRESHOLD=0.85
MAX_RETRIES=3

# Controlled concurrency for parallel AI evaluation (rate-limit safe)
AI_EVAL_CONCURRENCY=3

# Explicit output-token budget for question-GENERATION calls. Multi-candidate
# calls (initial batch, 3-candidate regeneration pool) can exceed provider
# defaults (e.g. 8192) and get truncated mid-question. Raise if you see
# "truncated/incomplete" validator rejections; lower if a provider rejects it.
AI_GENERATION_MAX_OUTPUT_TOKENS=16384

# Retrieval
RETRIEVAL_TOP_K=10
# Retrieval mode switch: legacy|vector (dense-only Qdrant, unchanged default) |
# hybrid (dense + BM25 -> RRF fusion -> rerank -> compress) | hybrid_graph
# (the SAME hybrid leg PLUS the Phase 8 knowledge-graph leg, fused — opt-in;
# vector/source evidence stays the factual authority, graph is context only).
RETRIEVAL_MODE=legacy

# Question Planner (Phase 9) — deterministic planning layer inserted between
# retrieval and generation (cognitive demand, transformation, answer target,
# evidence requirements, novelty constraints per slot/MIXED item). Zero LLM
# calls; opt-in; disabled by default. When false the pipeline and its prompts
# are byte-identical to pre-Phase-9 behavior.
QUESTION_PLANNER_ENABLED=false

# Grounding (deterministic evidence gate — CPU only, no AI calls)
# Minimum fraction of question content terms that must appear in retrieved notes.
MIN_EVIDENCE_COVERAGE=0.5
# Minimum number of content terms that must match (prevents false positives on very short questions).
MIN_EVIDENCE_TERMS=2

# ── Security Hardening ────────────────────────────────────────────────────────
# Allowed browser origins (comma-separated). Requests from other origins are
# rejected by CORS. MUST be set explicitly for any non-local deployment.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limits (requests per minute, per IP).
# AI tier: every route that triggers paid Gemini calls or heavy ingest
# (generate, analyze, notes upload, embed/index, paper upload).
RATE_LIMIT_AI_PER_MINUTE=6
# Default tier: cheap reads (health, job status, unit listing).
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# SSRF allowlist host for fileUrl downloads (must match your storage provider's
# delivery domain). With CLOUDINARY_CLOUD_NAME set, fileUrl must also start with
# /<CLOUDINARY_CLOUD_NAME>/. If CLOUDINARY_CLOUD_NAME is empty, all fileUrl
# downloads are refused (fail closed).
CLOUDINARY_HOST=res.cloudinary.com
